# Copy to .env (and .env.test for integration tests). Never commit real values.
# Generate JWT keys, the pepper and the encryption key with: npm run keys:generate

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of trusted reverse proxies in front of the API (0 when none)
TRUST_PROXY=0

DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/paystubsusa

# Frontend origin, used in email links and Stripe redirect URLs
APP_URL=http://localhost:5173
# Comma-separated browser origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:5173
# Defaults to true in production; set false only for plain-http local development
COOKIE_SECURE=false

JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER=paystubsusa-api
# At least 32 characters
CODE_PEPPER=
# 32 random bytes, base64
ENCRYPTION_MASTER_KEY=
ENCRYPTION_KEY_ID=local-v1

# Stripe test-mode keys (sk_test_..., whsec_... from `stripe listen`)
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
# Seed only: recurring Price for unlimited_monthly
STRIPE_UNLIMITED_PRICE_ID=

# local (development) or s3 (required in production)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage
S3_BUCKET=
S3_REGION=us-east-1
# Only for S3-compatible services (MinIO, R2); leave empty for AWS
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# log (development, writes to LOCAL_MAIL_DIR) or postmark (required in production)
MAIL_DRIVER=log
LOCAL_MAIL_DIR=.mail
POSTMARK_SERVER_TOKEN=
MAIL_FROM=no-reply@paystubsusa.local
SUPPORT_EMAIL=support@paystubsusa.local

# Built renderer bundle (packages/documents → renderer/index.html). Renders fail until it exists.
RENDERER_BUNDLE_PATH=
# Optional; defaults to the Playwright-managed Chromium
CHROMIUM_EXECUTABLE_PATH=
RENDER_CONCURRENCY=2

JOBS_ENABLED=true
SCHEDULER_ENABLED=true

# Seed only: first admin account (password at least 12 characters)
SEED_ADMIN_EMAIL=admin@paystubsusa.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
# Seed only, non-production: demo customer with a verified email (password at least 12 characters)
SEED_CUSTOMER_EMAIL=customer@paystubsusa.local
SEED_CUSTOMER_PASSWORD=
SEED_CUSTOMER_NAME=Demo Customer
