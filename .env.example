# Copy to .env (and .env.test for integration tests). Never commit real values.
# Generate JWT keys, the pepper and the encryption key with: npm run keys:generate

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of trusted reverse proxies in front of the API (0 when none)
TRUST_PROXY=0

DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/paystubsusa

# Frontend origin, used in email links and Stripe redirect URLs
APP_URL=http://localhost:5173
# Comma-separated browser origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:5173
# Defaults to true in production; set false only for plain-http local development
COOKIE_SECURE=false

JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER=paystubsusa-api
# At least 32 characters
CODE_PEPPER=
# 32 random bytes, base64
ENCRYPTION_MASTER_KEY=
ENCRYPTION_KEY_ID=local-v1

# Stripe test-mode keys (sk_test_..., whsec_... from `stripe listen`)
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
# Seed only: recurring Price for unlimited_monthly
STRIPE_UNLIMITED_PRICE_ID=

# Public origin of this API (no trailing slash), used in signed file-download links.
# Required in production, e.g. https://api.example.com; defaults to http://localhost:PORT otherwise.
PUBLIC_API_URL=

# Uploaded avatars and generated PDFs. In production, mount this directory on a persistent volume.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage

# smtp (required in production) or log (development/tests: writes each email to LOCAL_MAIL_DIR)
MAIL_DRIVER=log
LOCAL_MAIL_DIR=.mail
# Required when MAIL_DRIVER=smtp. Gmail: SMTP_PASSWORD is a 16-character App Password (not your
# account password), and MAIL_FROM should be the SMTP_USER address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@paystubsusa.local
SUPPORT_EMAIL=support@paystubsusa.local

# Built renderer bundle: run `npm run build:renderer` in web/, then point here. Renders fail until it exists.
RENDERER_BUNDLE_PATH=../web/dist-renderer/index.html
# Optional; defaults to the Playwright-managed Chromium
CHROMIUM_EXECUTABLE_PATH=
RENDER_CONCURRENCY=2

JOBS_ENABLED=true
SCHEDULER_ENABLED=true

# Seed only: first admin account (password at least 12 characters)
SEED_ADMIN_EMAIL=admin@paystubsusa.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
# Seed only, non-production: demo customer with a verified email (password at least 12 characters)
SEED_CUSTOMER_EMAIL=customer@paystubsusa.local
SEED_CUSTOMER_PASSWORD=
SEED_CUSTOMER_NAME=Demo Customer
